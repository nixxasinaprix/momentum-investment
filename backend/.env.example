# Environment: development | staging | production
APP_ENV=development

# Required outside development (e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=replace-with-a-random-64-char-hex-secret

# Database connection string (SQLite locally, PostgreSQL on Render/staging/production)
# Example Postgres: postgresql://user:password@host:5432/momentum
DATABASE_URL=sqlite:///momentum.db

# Comma-separated frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limit storage URI (memory:// or redis://localhost:6379/1)
RATELIMIT_STORAGE_URI=memory://
AUTH_RATE_LIMIT=10 per minute
